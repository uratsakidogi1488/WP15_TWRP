/system /system ext4 ro wait,slotselect,avb=vbmeta_system,logical
/vendor /system ext4 ro wait,slotselect,avb,logical
/product /product ext4 ro wait,slotselect,avb,logical

/dev/block/by-name/metadata /metadata ext4 noatime,nosuid,nodev,noauto_da_alloc,discard wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,reserve_root=134217,resgid=10657 wait,check,formattable
